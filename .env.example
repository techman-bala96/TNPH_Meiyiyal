SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Local dev: no network calls to any Supabase project; uses bundled seed data + demo auth
VITE_USE_MOCKS=true
VITE_GOOGLE_MAPS_API_KEY=
VITE_AGENT_URL=http://127.0.0.1:8787

# Web Push (M9). Make a pair with: node scripts/gen-vapid-keys.mjs
# Public key for the browser (optional: the app can also read it from GET /functions/v1/push-send)
VITE_VAPID_PUBLIC_KEY=
# Edge Function secrets: put these in supabase/functions/.env locally (git-ignored) or `supabase secrets set` in production
# VAPID_PRIVATE_KEY_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
# VAPID_SUBJECT=mailto:support@example.com
