# Meiyiyal — every setting the code reads, with no values. Copy what you need:
#   web app (Vite)         → .env.local                      (VITE_* only; these end up in the public JS bundle — never put secrets here)
#   Edge Functions         → supabase/functions/.env locally, `supabase secrets set KEY=value` in production
#   voice agent            → services/agent/.env (or the host's environment)
#   verification service   → services/verify/.env  (see services/verify/.env.example)
# Empty / unset = the safe default noted on each line (usually a mock or the free fallback).
# Runtime switches that admins change live (payments_mock, payouts_auto, kyc_provider, admin_mfa_required …) are NOT env:
# they are in Admin → Settings (public.app_settings). See docs/HANDOFF.md.

# ───────────────────────────── Web app (.env.local) ─────────────────────────────
VITE_SUPABASE_URL=                 # local: http://127.0.0.1:54321 · prod: https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=     # anon / publishable key (public by design; RLS protects data)
VITE_AGENT_URL=                    # voice agent base URL, e.g. http://127.0.0.1:8787 · prod: https://agent.meiyiyal.com
VITE_STT=                          # browser (default) | server (agent /agent/stt) | auto (browser, else server)
VITE_MAPS_PROVIDER=                # osm (default: OSM tiles + Nominatim) | google
VITE_GOOGLE_MAPS_BROWSER_KEY=      # Google Maps JS key, HTTP-referrer restricted to meiyiyal.com (only with google)
VITE_MAP_TILE_URL=                 # override OSM tile template (default tile.openstreetmap.org; use a paid/tile CDN in prod)
VITE_NOMINATIM_URL=                # override Nominatim base (default nominatim.openstreetmap.org — 1 req/s policy)
VITE_ICE_SERVERS=                  # optional JSON RTCIceServer[] fallback; normally fetched from the ice-servers function
VITE_CALL_PROVIDER=                # webrtc (default) | hms (100ms first, WebRTC fallback; needs the HMS_* secrets)
VITE_VAPID_PUBLIC_KEY=             # Web Push public key (node scripts/gen-vapid-keys.mjs); optional, push-send GET also serves it
VITE_CAPTCHA_PROVIDER=             # none (default) | mock (test widget) | turnstile | hcaptcha — enable [auth.captcha] to match
VITE_CAPTCHA_SITE_KEY=             # Turnstile / hCaptcha site key (public)
VITE_ADMIN_HOST=                   # e.g. admin.meiyiyal.com → /admin only on that host (docs/admin-subdomain.md)
VITE_TEST_MODE=                    # true = TEST deployment: "Test version" bar on every screen + noindex (docs/GO-LIVE.md §test); empty/false in production
VITE_GRIEVANCE_NAME=               # Grievance Officer shown on /privacy and /terms (DPDP); empty = "To be appointed"
VITE_GRIEVANCE_EMAIL=
VITE_GRIEVANCE_PHONE=
VITE_GRIEVANCE_ADDRESS=

# ─────────────── Edge Function secrets (supabase/functions/.env · supabase secrets set) ───────────────
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# Payments (Razorpay Checkout). Empty → payments_mock setting keeps the mock checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # Dashboard → Webhooks → secret for /functions/v1/payments-webhook
MOCK_PAYMENT_SECRET=               # local mock checkout signing (any random string)
MOCK_WEBHOOK_SECRET=
# Payouts (RazorpayX). Empty → payouts_mock setting keeps mock payouts.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=          # RazorpayX current-account number payouts are drawn from
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_BASE_URL=                # default https://api.razorpay.com/v1
# SMS (sign-in OTP via the Auth Send-SMS hook, step-up codes). SMS_PROVIDER=mock writes to public.sms_outbox.
SMS_PROVIDER=                      # mock (default) | msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=                   # 6-letter DLT header, e.g. MEIYAL
MSG91_TEMPLATE_LOGIN_OTP=          # MSG91 template id (DLT text carries ##otp##)
MSG91_TEMPLATE_STEPUP=
SEND_SMS_HOOK_SECRET=              # "v1,whsec_…" from Auth → Hooks → Send SMS
# Aadhaar e-KYC (used when the kyc_provider setting is 'edge')
KYC_PROVIDER=                      # mock (dev only) | surepass — unset → 503 "verification unavailable"
KYC_MOCK_OTP=                      # mock OTP, default 123456
SUREPASS_TOKEN=
SUREPASS_BASE_URL=
# Calls: TURN / ICE
ICE_PROVIDER=                      # stun (default) | coturn | static
TURN_URLS=                         # coturn: comma list of turn:/turns: URLs (deploy/coturn)
TURN_SECRET=                       # coturn static-auth-secret
TURN_TTL=                          # seconds, default 3600
STUN_URLS=                         # optional override of the STUN list
ICE_SERVERS_JSON=                  # static: JSON RTCIceServer[] from a managed TURN vendor
# 100ms (only with VITE_CALL_PROVIDER=hms)
HMS_ACCESS_KEY=
HMS_APP_SECRET=
HMS_ROOM_ID=
HMS_TEMPLATE_ROLE=                 # default guest
# Maps (server-side geocoding proxy maps-geo). Empty → app uses Nominatim.
GOOGLE_MAPS_SERVER_KEY=            # Geocoding + Places API key, API-restricted, no referrer
# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_JWK=             # {"kty":"EC","crv":"P-256",…,"d":"…"} from scripts/gen-vapid-keys.mjs
VAPID_SUBJECT=                     # mailto:support@meiyiyal.com

# ───────────────────────────── Voice agent (services/agent) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=               # verifies user tokens; hosted: Project Settings → API → JWT secret
AGENT_CORS=                        # comma list of allowed origins, e.g. https://meiyiyal.com
AGENT_RATE_PER_HOUR=               # per-user request cap
AGENT_LEXICON_FILE=
AGENT_LEXICON_TTL=
AGENT_LLM_PROVIDER=                # "" (off, grammar only) | mock | openai (any OpenAI-compatible endpoint)
AGENT_LLM_URL=
AGENT_LLM_KEY=
AGENT_LLM_MODEL=
AGENT_STT_PROVIDER=                # "" (off → 503) | mock | google | openai
AGENT_STT_URL=
AGENT_STT_KEY=
AGENT_STT_MODEL=

# ───────────────────── Verification service (services/verify) — see services/verify/.env.example ─────────────────────
SUPABASE_SERVICE_ROLE_KEY=
VERIFY_HMAC_PEPPER=
VERIFY_SERVICE_KEY=
VERIFY_POLL_SECONDS=
VERIFY_MAINTENANCE_SECONDS=
OCR_PROVIDER=                      # mock | tesseract
OCR_LANGS=
OCR_MOCK_TEXT=
FACE_PROVIDER=                     # mock | insightface
FACE_MODEL=
FACE_PASS=
FACE_REVIEW=
LIVENESS_PROVIDER=                 # mock | vendor
LIVENESS_VENDOR_URL=
LIVENESS_VENDOR_KEY=
UIDAI_QR_CERT_PATH=                # UIDAI public certificate for offline Aadhaar QR signature checks

# ───────────────────── Supabase Auth (config.toml env(...) / hosted dashboard) ─────────────────────
SUPABASE_AUTH_SITE_URL=            # https://meiyiyal.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_CAPTCHA_SECRET=      # Turnstile / hCaptcha secret, when [auth.captcha] is enabled
