# FALLBACK ONLY: the app is hosted on Cloudflare Pages (deploy/cloudflare/, docs/GO-LIVE.md §2). Keep the CSP in step
# with deploy/cloudflare/_headers.
# Meiyiyal web app on Hostinger (Apache / LiteSpeed). Upload the contents of dist/ to public_html/ together with this file.
# Same file for admin.meiyiyal.com (docs/admin-subdomain.md).
Options -Indexes
RewriteEngine On

# Force HTTPS and the bare domain (www → meiyiyal.com)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.meiyiyal\.com$ [NC]
RewriteRule ^ https://meiyiyal.com%{REQUEST_URI} [L,R=301]

# Optional: only these IPs may open the admin host. Uncomment and list office / home IPs.
# RewriteCond %{HTTP_HOST} ^admin\.meiyiyal\.com$ [NC]
# RewriteCond %{REMOTE_ADDR} !^(203\.0\.113\.10|198\.51\.100\.7)$
# RewriteRule ^ - [F]

# Single-page app: real files are served, everything else gets index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(self)"
  # CSP: Supabase (REST/Realtime), Razorpay checkout, maps, captcha, voice agent. Tighten <project-ref> / hosts before launch;
  # test in Report-Only first (rename the header to Content-Security-Policy-Report-Only).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://challenges.cloudflare.com https://js.hcaptcha.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://maps.gstatic.com https://maps.googleapis.com https://*.googleusercontent.com; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://agent.meiyiyal.com https://nominatim.openstreetmap.org https://api.razorpay.com https://lumberjack.razorpay.com https://maps.googleapis.com https://*.hcaptcha.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://challenges.cloudflare.com https://*.hcaptcha.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  # The admin console is never indexed
  <If "%{HTTP_HOST} == 'admin.meiyiyal.com' || %{REQUEST_URI} =~ m#^/admin#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Caching: hashed build assets forever, the shell and service worker never
  <FilesMatch "\.(js|css|woff2|png|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|registerSW\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
